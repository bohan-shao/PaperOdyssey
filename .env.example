# ===== Copy to .env and fill in real values (.env is gitignored, do not commit) =====

# Generation LLM (DeepSeek by default, OpenAI-compatible protocol)
# Apply at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# If switching to OpenAI or another compatible service:
#   OPENAI_API_KEY=sk-xxxx
#   LLM_MODEL=gpt-4o-mini
#   LLM_BASE_URL=https://api.openai.com/v1

# The client reads LLM_BASE_URL / LLM_MODEL (LLM_* prefix, wrapped by
# llm/client.py). Do not read environment variables directly in business code.

# Knowledge base (kb/), both optional
# OpenAlex API key (free at https://openalex.org): anonymous use is capped at ~1000 calls/day,
# a full citation lookup of the candidate pool needs more. Contact email goes into the
# User-Agent / OpenAlex polite pool.
OPENALEX_API_KEY=
KB_CONTACT_EMAIL=
